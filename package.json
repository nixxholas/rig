{
    "name": "@slopus/rig-workspace",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm --filter @slopus/happy-providers build && pnpm --filter @slopus/rig-execution build && pnpm --filter @slopus/rig-codemode-codex build && pnpm --filter happy-plugins build && pnpm --filter happy-worklets build && pnpm --filter @slopus/rig build",
        "build:gym": "pnpm --filter @slopus/rig-gym run build:image",
        "check": "pnpm --filter @slopus/happy-providers build && pnpm --filter @slopus/rig-execution build && pnpm --filter @slopus/rig-codemode-codex build && pnpm --filter happy-plugins build && pnpm --filter happy-worklets build && pnpm run check:root && pnpm --recursive --filter './packages/**' run check",
        "check:root": "tsc --noEmit -p tsconfig.json",
        "database:inspect": "TMPDIR=\"$PWD/.local\" tsx scripts/database/inspectRigDatabaseCli.ts",
        "dev": "pnpm --filter @slopus/happy-providers build && pnpm --filter happy-worklets build && pnpm --filter @slopus/rig-dev dev",
        "dev:global": "pnpm exec tsx packages/rig-dev/sources/global.ts",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "link:dev": "cd packages/rig-dev && pnpm link --global",
        "lint": "oxlint .",
        "observability:down": "docker compose -f observability/docker-compose.yml down",
        "observability:up": "docker compose -f observability/docker-compose.yml up -d",
        "release": "TMPDIR=\"$PWD/.local\" tsx scripts/release.ts",
        "release:beta": "pnpm release beta",
        "release:minor": "pnpm release minor",
        "release:patch": "pnpm release patch",
        "release:happy-providers:patch": "pnpm release happy-providers patch",
        "release:happy-plugins:patch": "pnpm release happy-plugins patch",
        "release:rig-connect:patch": "pnpm release rig-connect patch",
        "start": "node packages/rig/dist/main.js",
        "start:build": "pnpm build && pnpm start",
        "test": "pnpm run test:scripts && pnpm --recursive --filter './packages/**' run test",
        "test:release": "pnpm run test:scripts && pnpm --recursive --workspace-concurrency=1 --filter './packages/**' --filter '!@slopus/happy-providers' run test",
        "test:gym": "pnpm --filter @slopus/rig-gym-tests test:gym",
        "test:gym:fast": "pnpm --filter @slopus/rig-gym-tests test:gym:fast",
        "test:gym:full": "pnpm --filter @slopus/rig-gym-tests test:gym:full",
        "test:gym:heavy": "pnpm --filter @slopus/rig-gym-tests test:gym:heavy",
        "test:gym:docker": "pnpm --filter @slopus/rig-gym-tests test:gym:docker",
        "test:gym:slow": "pnpm --filter @slopus/rig-gym-tests test:gym:slow",
        "test:live": "pnpm --filter @slopus/rig test:live",
        "test:scripts": "TMPDIR=\"$PWD/.local\" tsx --test scripts/release/*.test.ts",
        "test:watch": "pnpm --filter @slopus/rig test:watch",
        "unlink:dev": "pnpm remove --global @slopus/rig-dev"
    },
    "devDependencies": {
        "@types/node": "^24.0.10",
        "drizzle-orm": "^0.45.2",
        "oxfmt": "^0.57.0",
        "oxlint": "^1.72.0",
        "tsx": "^4.23.0",
        "typescript": "^5.8.3"
    },
    "packageManager": "pnpm@10.28.1",
    "pnpm": {
        "onlyBuiltDependencies": [
            "@ffmpeg-installer/darwin-arm64",
            "@ffmpeg-installer/darwin-x64",
            "@ffmpeg-installer/linux-arm",
            "@ffmpeg-installer/linux-arm64",
            "@ffmpeg-installer/linux-ia32",
            "@ffmpeg-installer/linux-x64",
            "@ffmpeg-installer/win32-ia32",
            "@ffmpeg-installer/win32-x64",
            "@ffprobe-installer/darwin-arm64",
            "@ffprobe-installer/darwin-x64",
            "@ffprobe-installer/linux-arm",
            "@ffprobe-installer/linux-arm64",
            "@ffprobe-installer/linux-ia32",
            "@ffprobe-installer/linux-x64",
            "@ffprobe-installer/win32-ia32",
            "@ffprobe-installer/win32-x64"
        ]
    }
}
