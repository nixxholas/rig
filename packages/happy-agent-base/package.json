{
    "name": "@slopus/happy-agent-base",
    "version": "0.0.0",
    "description": "Shared foundations for Happy coding agents.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slopus/rig.git",
        "directory": "packages/happy-agent-base"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@sinclair/typebox": "^0.34.49",
        "@slopus/happy-providers": "0.0.5",
        "@steve.kite/stdlib": "0.0.8"
    },
    "scripts": {
        "build": "node --eval \"import('node:fs/promises').then(({ rm }) => rm('dist', { force: true, recursive: true }))\" && tsc -p tsconfig.build.json",
        "check": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "devDependencies": {
        "@types/node": "^24.0.10",
        "typescript": "^7.0.2",
        "vitest": "^3.2.4"
    },
    "engines": {
        "node": ">=22.19.0"
    }
}
