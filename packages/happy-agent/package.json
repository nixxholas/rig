{
    "name": "@slopus/happy-agent",
    "version": "0.0.0",
    "description": "The complete Happy agent API.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slopus/rig.git",
        "directory": "packages/happy-agent"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node --eval \"import('node:fs/promises').then(({ rm }) => rm('dist', { force: true, recursive: true }))\" && tsc -p tsconfig.build.json",
        "check": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@libsql/client": "^0.17.4",
        "@paralleldrive/cuid2": "^3.3.0",
        "@sinclair/typebox": "^0.34.49",
        "@slopus/happy-agent-base": "npm:@slopus/happy-agent-base@0.0.20",
        "@slopus/happy-agent-compute": "npm:@slopus/happy-agent-compute@0.1.6",
        "@slopus/happy-agent-modules": "workspace:*",
        "@slopus/happy-providers": "workspace:*",
        "@steve.kite/stdlib": "0.0.12",
        "deunicode": "1.0.7",
        "drizzle-orm": "^0.45.2",
        "sharp": "^0.35.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^24.0.10",
        "typescript": "^7.0.2",
        "vitest": "^3.2.4"
    },
    "engines": {
        "node": ">=22.19.0"
    }
}
