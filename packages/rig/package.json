{
    "name": "@slopus/rig",
    "version": "0.2.20",
    "description": "Terminal client and daemon launcher for the Happy coding agent.",
    "keywords": [
        "coding-agent",
        "terminal"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slopus/rig.git"
    },
    "bin": {
        "rig": "./dist/main.js"
    },
    "files": [
        "dist",
        "LICENSE-CODEX",
        "LICENSE-HAPPY",
        "LICENSE-GROK-BUILD",
        "THIRD-PARTY-NOTICES.md"
    ],
    "type": "module",
    "exports": {
        "./types": {
            "types": "./dist/types.d.ts"
        },
        "./package-version": {
            "types": "./dist/readPackageVersion.d.ts",
            "import": "./dist/readPackageVersion.js",
            "default": "./dist/readPackageVersion.js"
        },
        "./dist/main.js": "./dist/main.js",
        "./dist/readPackageVersion.js": {
            "types": "./dist/readPackageVersion.d.ts",
            "import": "./dist/readPackageVersion.js",
            "default": "./dist/readPackageVersion.js"
        },
        "./dist/protocol/index.js": {
            "types": "./dist/types.d.ts"
        },
        "./dist/terminal/index.js": {
            "types": "./dist/types.d.ts"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "TMPDIR=\"$PWD/../../.local\" tsx scripts/build.ts",
        "check": "tsc --noEmit",
        "dev": "pnpm --filter @slopus/rig-dev dev",
        "start": "node dist/main.js",
        "test": "vitest run --isolate=false",
        "test:live": "RIG_LIVE_TEST=1 vitest run -c vitest.live.config.ts",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@earendil-works/pi-tui": "^0.80.3",
        "@lydell/node-pty": "1.2.0-beta.12",
        "@mariozechner/clipboard": "^0.3.9",
        "@opentelemetry/api": "^1.9.1",
        "@paralleldrive/cuid2": "^3.3.0",
        "@sinclair/typebox": "^0.34.49",
        "@slopus/ghostty-wasm": "1.3.6",
        "@slopus/ghostty-web": "workspace:*",
        "@slopus/happy-agent": "workspace:*",
        "@slopus/happy-agent-client": "workspace:*",
        "@slopus/happy-agent-modules": "workspace:*",
        "@slopus/happy-providers": "0.0.10",
        "@steve.kite/stdlib": "0.0.12",
        "smol-toml": "^1.7.0",
        "ws": "^8.21.1"
    },
    "devDependencies": {
        "@libsql/client": "^0.17.4",
        "@types/node": "^24.0.10",
        "@types/ws": "^8.18.1",
        "esbuild": "^0.28.1",
        "tsx": "^4.23.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "engines": {
        "node": ">=24"
    }
}
